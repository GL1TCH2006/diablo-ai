# DIABLO configuration.
# Copy to .env and adjust. Never commit .env.

# Provider: ollama (additional providers added in later phases)
AI_PROVIDER=ollama

# Ollama service
OLLAMA_HOST=http://localhost:11434

# Leave empty to auto-detect an installed model.
# Example: AI_MODEL=qwen3:latest
AI_MODEL=

# Root folder scanned for project awareness (the Nami workspace).
WORKSPACE_ROOT=C:\PROJECTS

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Speak replies using Windows SAPI text-to-speech.
VOICE_ENABLED=false